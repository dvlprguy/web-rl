# Copy to .env and fill in. NEVER commit real keys — .env is git-ignored.

# Used by site generation (pipeline/generate.py) and by the agent (Claude Code).
# The grader does NOT need this — it is fully offline.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only to run tasks on Modal instead of local Docker.
# Set these via the Modal CLI, not here:
#   modal token set --token-id <id> --token-secret <secret> --profile <name>
#   modal profile activate <name>
